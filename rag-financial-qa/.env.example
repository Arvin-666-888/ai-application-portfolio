APP_NAME=上市公司财报与公告智能问答系统
DEBUG=false

DATABASE_URL=sqlite:///./kb_qa.db
SQLITE_BUSY_TIMEOUT_MS=5000
DOCUMENT_JOB_LEASE_SECONDS=300
DOCUMENT_JOB_STALE_AFTER_SECONDS=600
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_RETRY_BASE_SECONDS=5
DOCUMENT_JOB_RETRY_MAX_SECONDS=300
DOCUMENT_WORKER_POLL_SECONDS=1.0
DOCUMENT_PARSE_SNAPSHOT_DIR=./parse_snapshots
# Paddle worker is disabled by default. The supported host-worker topology is
# Windows-only: API + document worker + Paddle worker must all run from this
# repository root and share these relative SQLite/file paths. Do not combine
# Docker Compose with a host Paddle worker; Compose overrides this to docker_only
# and the Paddle worker fails before opening the database.
# Install: py -3.12 -m venv .venv-paddle-worker
#          .\.venv-paddle-worker\Scripts\python.exe -m pip install -r requirements-paddle-worker-windows-py312.txt
# Smoke:   set PADDLE_WORKER_DEPLOYMENT_MODE=windows_same_root
#          .\.venv-paddle-worker\Scripts\python.exe -m app.workers.paddle_worker --smoke-check
# Copy the reported fingerprint into PDF_PADDLE_EXPECTED_ENGINE_FINGERPRINT before a real worker start.
PADDLE_WORKER_DEPLOYMENT_MODE=disabled
PADDLE_WORKER_SHARED_ROOT=.
PADDLE_WORKER_DEVICE=gpu
PADDLE_WORKER_LOCK_FILE=./requirements-paddleocr-windows-py312.lock.txt
# Generate a random secret before starting with DEBUG=false.
SECRET_KEY=
ALLOW_INSECURE_DEMO_MODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_data
MAX_FILE_SIZE=10485760

# OpenAI-compatible API. Leave API_KEY empty to use mock mode.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=3
MAX_HISTORY_ROUNDS=5

# Three-layer PDF parsing router (L1 native text, L2 hi_res, L3 validated OCR artifacts)
PDF_PARSE_PROFILE=three_layer_v1
PDF_HI_RES_ENABLED=true
PDF_HI_RES_MAX_PAGES_PER_DOCUMENT=80
PDF_PADDLE_ARTIFACT_ENABLED=false
PDF_PADDLE_ARTIFACT_DIR=./ocr_artifacts
# Required 64-character fingerprint when artifact loading is enabled.
PDF_PADDLE_EXPECTED_ENGINE_FINGERPRINT=
PDF_NATIVE_TEXT_MIN_CHARS=20
PDF_TABLE_NUMERIC_RATIO_MIN=0.18
PDF_TABLE_LINE_COUNT_MIN=15
PDF_TABLE_TITLE_NEIGHBOR_BEFORE=1
PDF_TABLE_TITLE_NEIGHBOR_AFTER=3
PDF_TABLE_ROW_OVERLAP=1

# Retrieval quality controls
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_PROFILE=legacy
# V3 is opt-in until independent answer-quality acceptance passes.
RAG_ANSWER_PROFILE=legacy
RAG_CONTEXT_MAX_CHARS=24000
RAG_CONTEXT_ITEM_MAX_CHARS=6000
LEXICAL_WEIGHT=0.35
NUMERIC_WEIGHT=0.15
MIN_RELEVANCE_SCORE=0.05

# Optional estimated-cost rates. Leave blank when rates are not frozen.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=
EMBEDDING_COST_PER_1M=
COST_CURRENCY=USD
