APP_NAME=智能数据分析助手
DEBUG=false

DATABASE_URL=sqlite:///./data_analyst.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

CHART_DIR=./charts
SAMPLE_DB_PATH=./sample_data/sample.db

# Leave API_KEY empty to use deterministic mock mode for local demos.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

MAX_AGENT_STEPS=8
MAX_QUERY_ROWS=1000
MAX_TOOL_RESULT_CHARS=2500
MAX_PREVIEW_ROWS=3
MAX_CHART_ITEMS=30

# Optional: enable only when a compatible RAG service is available.
RAG_ENABLED=false
RAG_API_BASE_URL=http://localhost:8018
RAG_ACCESS_TOKEN=
RAG_CONVERSATION_ID=0
RAG_TIMEOUT=30
